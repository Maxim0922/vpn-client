<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>de.max-tsx.maxvpn.daemon</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/maxvpnd</string>
	</array>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<key>UserName</key>
	<string>root</string>

	<key>ProcessType</key>
	<string>Interactive</string>

	<key>StandardOutPath</key>
	<string>/var/log/maxvpnd.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/maxvpnd.log</string>
</dict>
</plist>
